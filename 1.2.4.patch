--- /dev/null
+++ b/src/common/utils/mergeSetting.ts
@@ -0,0 +1,22 @@
+import defaultSetting from '../defaultSetting'
+
+export function mergeSetting(
+  localConfig: Record<string, any>,
+  migratedConfig: Record<string, any>
+): typeof defaultSetting {
+  const finalConfig: any = {}
+
+  for (const key of Object.keys(defaultSetting)) {
+    if (key in migratedConfig && migratedConfig[key] !== undefined) {
+      finalConfig[key] = migratedConfig[key]
+    } else {
+      finalConfig[key] = (defaultSetting as any)[key]
+    }
+  }
+
+  finalConfig.version = defaultSetting.version
+  if (migratedConfig._deprecated) {
+    finalConfig._deprecated = migratedConfig._deprecated
+  }
+
+  return finalConfig
+}
diff --git a/src/common/utils/settingManager.ts b/src/common/utils/settingManager.ts
new file mode 100644
