+++ b/src/common/utils/settingManager.ts
@@ -0,0 +1,10 @@
+import migrateSetting from './migrateSetting'
+import { mergeSetting } from './mergeSetting'
+import defaultSetting from '../defaultSetting'
+
+export function processUserConfig(userConfig: Record<string, any>): typeof defaultSetting {
+  const migrated = migrateSetting(userConfig)
+  const finalConfig = mergeSetting(userConfig, migrated)
+  return finalConfig
+}
