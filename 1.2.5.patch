diff --git a/src/common/utils/migrateSetting.ts b/src/common/utils/migrateSetting.ts
index 23eeb276..d4e5f6a7 100644
--- a/src/common/utils/migrateSetting.ts
+++ b/src/common/utils/migrateSetting.ts
@@ -1,5 +1,10 @@
 import { compareVer } from './index'

+const DEPRECATED_CONFIG_KEY = '_deprecated'
+
+interface DeprecationRecord {
+  [key: string]: any
+}

 const oldThemeMap = {
   0: 'green',
@@ -136,8 +141,46 @@ export default (setting: any): Partial<LX.AppSetting> => {
     setting['sync.erver.port'] = setting['sync.port']
     setting.version = '2.1.0'
   }
+

+  // ========== v2.2.0 之前的迁移 ==========
+  // 变更点：
+  // 1. player.playQuality 从字符串（如 '128k'）改为数字（如 128）
+  // 2. 新增 player.crossfade 字段（通过白名单合并自动补全，无需手动处理）
+  if (compareVer(setting.version, '2.2.0') < 0) {
+    const playQuality = setting['player.playQuality']
+    if (typeof playQuality === 'string') {
+      const match = playQuality.match(/^(\d+)/)
+      if (match) {
+        setting['player.playQuality'] = parseInt(match[1], 10)
+      } else {
+        setting['player.playQuality'] = 128
+      }
+    }
+
+    setting.version = '2.2.0'
+  }
+
+  // ========== v2.3.0 之前的迁移 ==========
+  // 变更点：
+  // 1. common.controlBtnPosition 被废弃，不再支持
+  //    将废弃值保存到 _deprecated 保留区，保证数据不丢失且可降级回滚
+  //    最终配置中该字段由白名单合并机制自动过滤（defaultSetting 中已移除该 key）
+  if (compareVer(setting.version, '2.3.0') < 0) {
+    const deprecatedValue = setting['common.controlBtnPosition']
+    if (deprecatedValue !== undefined) {
+      if (!setting[DEPRECATED_CONFIG_KEY]) {
+        setting[DEPRECATED_CONFIG_KEY] = {}
+      }
+      ;(setting[DEPRECATED_CONFIG_KEY] as DeprecationRecord)['common.controlBtnPosition'] = deprecatedValue
+    }
+
+    setting.version = '2.3.0'
+  }


   return setting
 }

